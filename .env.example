# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in the Supabase dashboard: Project Settings -> API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only privileged key. Bypasses Row Level Security, so it must never be
# prefixed with NEXT_PUBLIC_ or imported into client components. Only needed for
# trusted server-side tasks (admin scripts, maintenance); the app does not read it.
# Paste either the legacy service_role JWT or a new secret key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public production URL (no trailing slash). Used for metadataBase, canonical URLs,
# sitemap.xml, robots.txt and Open Graph images. Falls back to https://licomanagement.com.
NEXT_PUBLIC_SITE_URL=https://licomanagement.com